{
  "name": "still-breathing",
  "version": "1.0.0",
  "description": "Are the links on your site still breathing? A small link checker for built sites, Markdown and notes: finds dead links, says where they are, and can open an issue every month. No dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "still-breathing": "bin/still-breathing.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "link-checker",
    "broken-links",
    "dead-links",
    "link-rot",
    "static-site",
    "markdown",
    "github-actions",
    "indieweb",
    "cli"
  ],
  "author": "Erick Donado (https://github.com/KanuSaru)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanuSaru/still-breathing.git"
  },
  "homepage": "https://github.com/KanuSaru/still-breathing#readme"
}
